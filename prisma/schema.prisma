generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  DRIVER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  INVITED
}

enum BookingStatus {
  PENDING_PAYMENT
  CONFIRMED
  DRIVER_ASSIGNMENT_PENDING
  DRIVER_ASSIGNED
  DRIVER_ACCEPTED
  DRIVER_EN_ROUTE
  DRIVER_ARRIVED
  TRIP_STARTED
  TRIP_COMPLETED
  CANCELLED
  NO_SHOW
  REFUNDED
}

enum TripDirection {
  AIRPORT_TO_CITY
  CITY_TO_AIRPORT
}

enum TripType {
  AIRPORT_TRANSFER
  PRIVATE_TRANSFER
  HOTEL_TRANSFER
  CITY_TRANSFER
  TOURIST_TOUR
}

enum PaymentMethod {
  UNDECIDED
  ONLINE
  DRIVER
}

enum PaymentStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  REFUNDED
}

enum VehicleIconCategory {
  TUK_TUK
  PASSAPP
  SEDAN
  SUV
  MINIVAN
  MINIBUS
  VAN
  OTHER
}

model User {
  id            String       @id @default(cuid())
  email         String       @unique
  name          String
  passwordHash  String
  phone         String?
  role          UserRole
  status        UserStatus   @default(ACTIVE)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  customer      CustomerProfile?
  driver        DriverProfile?
  administrator AdminProfile?
  bookings      Booking[]    @relation("CustomerBookings")
  messages      DriverMessage[]
  auditLogs     AuditLog[]
  customerSessions CustomerSession[]
  pushSubscriptions PushSubscription[]
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  language  String   @default("en")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deliveries PushDelivery[]

  @@index([userId])
}

model PushDelivery {
  id             String   @id @default(cuid())
  subscriptionId String
  subscription   PushSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  eventKey       String
  kind           String
  bookingId      String?
  driverId       String?
  reference      String?
  recipientRole  UserRole
  createdAt      DateTime @default(now())
  expiresAt      DateTime
  availableAt    DateTime @default(now())
  attempts       Int      @default(0)
  lockToken      String?
  lockedUntil    DateTime?
  sentAt         DateTime?
  failedAt       DateTime?
  lastError      String?

  @@unique([subscriptionId, eventKey])
  @@index([sentAt, failedAt, availableAt])
  @@index([createdAt])
}

model CustomerSession {
  tokenHash String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId])
}

enum CollectionMethod {
  CASH
  CARD
  ABA
  OTHER
}

model AdminProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  canManageUsers  Boolean  @default(true)
  canManageFleet  Boolean  @default(true)
  canManagePrices Boolean  @default(true)
  canManageBookings Boolean @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model CustomerProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  address   String?
  nationality String?
  preferredLanguage String?
  company   String?
  adminNotes String?
  paymentProviderCustomerId String?
  paymentBrand String?
  paymentLast4 String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DriverProfile {
  id           String          @id @default(cuid())
  userId       String          @unique
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  licenseNo    String?
  licenseExpiresAt DateTime?
  licenseCategory String?
  licenseImages DriverLicenseImage[]
  photo        DriverPhoto?
  contactQrImages DriverContactQrImage[]
  dateOfBirth  DateTime?
  nationality  String?
  idDocumentNo String?
  address      String?
  emergencyContactName  String?
  emergencyContactPhone String?
  adminNotes   String?
  employmentContracts EmploymentContract[]
  vehicleExpenses VehicleExpense[]
  payrolls Payroll[]
  isAvailable  Boolean         @default(true)
  availableSince DateTime      @default(now())
  selectedVehicleId String?
  selectedVehicle Vehicle?     @relation("DriverSelectedVehicle", fields: [selectedVehicleId], references: [id], onDelete: SetNull)
  returningToHub Boolean       @default(false)
  lastMovementPushAt DateTime?
  bookings     Booking[]       @relation("DriverBookings")
  locations    DriverLocation[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([isAvailable, availableSince])
}

enum LicenseSide {
  FRONT
  BACK
}

model DriverLicenseImage {
  id         String        @id @default(cuid())
  driverId   String
  driver     DriverProfile @relation(fields: [driverId], references: [id], onDelete: Cascade)
  side       LicenseSide
  mimeType   String
  sizeBytes  Int
  data       Bytes
  uploadedAt DateTime      @default(now())

  @@unique([driverId, side])
}

model DriverPhoto {
  id         String        @id @default(cuid())
  driverId   String        @unique
  driver     DriverProfile @relation(fields: [driverId], references: [id], onDelete: Cascade)
  mimeType   String
  sizeBytes  Int
  data       Bytes
  uploadedAt DateTime      @default(now())
}

enum DriverContactChannel {
  WHATSAPP
  TELEGRAM
}

model DriverContactQrImage {
  id         String               @id @default(cuid())
  driverId   String
  driver     DriverProfile        @relation(fields: [driverId], references: [id], onDelete: Cascade)
  channel    DriverContactChannel
  mimeType   String
  sizeBytes  Int
  data       Bytes
  uploadedAt DateTime             @default(now())

  @@unique([driverId, channel])
}

enum EmploymentContractStatus {
  DRAFT
  ACTIVE
  TERMINATED
}

model EmploymentContract {
  id                 String                   @id @default(cuid())
  reference          String                   @unique
  driverId           String
  driver             DriverProfile            @relation(fields: [driverId], references: [id], onDelete: Restrict)
  status             EmploymentContractStatus @default(DRAFT)
  position           String
  workplace          String
  startsAt           DateTime
  probationMonths    Int                      @default(0)
  hoursPerWeek       Int                      @default(48)
  monthlySalaryCents Int
  currency           String                   @default("USD")
  annualLeaveDays    Int                      @default(18)
  additionalTerms    String?
  activatedAt        DateTime?
  terminatedAt       DateTime?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  @@index([driverId])
}

model Vehicle {
  id            String              @id @default(cuid())
  name          String
  plate         String              @unique
  seats         Int
  active        Boolean             @default(true)
  iconCategory  VehicleIconCategory @default(OTHER)
  iconImage     VehicleIconImage?
  bookings      Booking[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  contracts     VehicleContract[]
  selectedByDrivers DriverProfile[] @relation("DriverSelectedVehicle")
  expenses      VehicleExpense[]
  accountingEntries AccountingEntry[]
}

model VehicleIconImage {
  id         String   @id @default(cuid())
  vehicleId  String   @unique
  vehicle    Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  mimeType   String
  sizeBytes  Int
  data       Bytes
  uploadedAt DateTime @default(now())
}

model Hub {
  id        String   @id @default(cuid())
  name      String
  address   String?
  latitude  Decimal  @db.Decimal(10, 7)
  longitude Decimal  @db.Decimal(10, 7)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum AccountingEntryType {
  REVENUE
  EXPENSE
  CREDIT
  PURCHASE
}

model AccountingEntry {
  id          String              @id @default(cuid())
  type        AccountingEntryType
  label       String
  amountCents Int
  currency    String              @default("USD")
  dueAt       DateTime?
  paidAt      DateTime?
  notes       String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  entryDate   DateTime            @default(now())
  category    AccountingCategory  @default(OTHER)
  sourceKey   String?             @unique
  deletedAt   DateTime?
  vehicleId   String?
  vehicle     Vehicle?            @relation(fields: [vehicleId], references: [id], onDelete: Restrict)

  @@index([entryDate, type, category])
}

enum AccountingCategory {
  TRIP
  FUEL
  MAINTENANCE
  SALARY
  OTHER
}

enum VehicleExpenseStatus {
  PENDING
  APPROVED
  REJECTED
}

model VehicleExpense {
  id          String               @id @default(cuid())
  requestId   String               @unique
  driverId    String?
  driver      DriverProfile?       @relation(fields: [driverId], references: [id], onDelete: Restrict)
  vehicleId   String
  vehicle     Vehicle              @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  category    AccountingCategory
  occurredAt  DateTime
  odometerKm  Decimal              @db.Decimal(12, 1)
  liters      Decimal?             @db.Decimal(10, 3)
  amountCents Int
  currency    String
  khrPerUsd   Decimal?             @db.Decimal(12, 4)
  usdCents    Int
  fullTank    Boolean              @default(false)
  notes       String?
  status      VehicleExpenseStatus @default(PENDING)
  reviewedAt  DateTime?
  reviewedBy  String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([vehicleId, occurredAt])
  @@index([driverId, status])
}

enum PayrollStatus {
  DRAFT
  FINALIZED
  PAID
}

model Payroll {
  id                 String        @id @default(cuid())
  driverId           String
  driver             DriverProfile @relation(fields: [driverId], references: [id], onDelete: Restrict)
  month              String
  status             PayrollStatus @default(DRAFT)
  commissionBps      Int           @default(8000)
  baseSalaryCents    Int
  eligibleRevenueCents Int
  commissionCents    Int
  bonusCents         Int           @default(0)
  deductionCents     Int           @default(0)
  netCents           Int
  currency           String        @default("USD")
  adjustmentNotes    String?
  snapshot           Json
  scheduledPayAt     DateTime
  finalizedAt        DateTime?
  paidAt             DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@unique([driverId, month])
  @@index([month, status])
}

model VehicleContract {
  id          String    @id @default(cuid())
  vehicleId   String
  vehicle     Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  provider    String
  monthlyCents Int
  startsAt    DateTime
  endsAt      DateTime?
  status      String    @default("ACTIVE")
  kind        VehicleContractKind @default(RENTAL)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

enum VehicleContractKind {
  RENTAL
  FINANCING
}

model ForecastLine {
  id          String   @id @default(cuid())
  month       DateTime
  expectedRevenueCents Int @default(0)
  expectedExpenseCents Int @default(0)
  notes       String?
  deletedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Booking {
  id             String          @id @default(cuid())
  reference      String          @unique
  customerId     String?
  customer       User?           @relation("CustomerBookings", fields: [customerId], references: [id], onDelete: Restrict)
  passengerName  String?
  originType     String          @default("CUSTOMER")
  startRequestId String?         @unique
  routeDetails   Json?
  estimatedPriceCents Int?
  pricingStatus  String          @default("AUTOMATIC")
  startedAt      DateTime?
  completedAt    DateTime?
  adminArchivedAt DateTime?
  actualDurationSeconds Int?
  driverObservations String?
  finalLatitude  Decimal?        @db.Decimal(10, 7)
  finalLongitude Decimal?        @db.Decimal(10, 7)
  driverId       String?
  driver         DriverProfile?  @relation("DriverBookings", fields: [driverId], references: [id], onDelete: SetNull)
  vehicleId      String?
  vehicle        Vehicle?        @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  fromAddress    String
  toAddress      String
  direction      TripDirection
  tripType       TripType
  pickupAt       DateTime
  dispatchEndsAt DateTime?
  flightNumber   String?
  contactPhone   String?
  passengers     Int
  luggageCount   Int             @default(0)
  specialNeeds   String?
  pickupNotes    String?
  priceCents     Int
  currency       String          @default("USD")
  status         BookingStatus   @default(PENDING_PAYMENT)
  paymentMethod  PaymentMethod   @default(UNDECIDED)
  metered        Boolean         @default(false)
  fareDetails    Json?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  statusHistory  BookingStatusHistory[]
  payments       Payment[]
  messages       DriverMessage[]
  blogPosts      BlogPost[]

  @@index([originType, pickupAt])
  @@index([driverId, pickupAt, dispatchEndsAt])
  @@index([vehicleId, pickupAt, dispatchEndsAt])
}

model BookingStatusHistory {
  id        String        @id @default(cuid())
  bookingId String
  booking   Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  status    BookingStatus
  note      String?
  createdAt DateTime      @default(now())
}

model DriverLocation {
  id        String        @id @default(cuid())
  driverId  String
  driver    DriverProfile @relation(fields: [driverId], references: [id], onDelete: Cascade)
  bookingId String?
  latitude  Decimal       @db.Decimal(10, 7)
  longitude Decimal       @db.Decimal(10, 7)
  accuracy  Decimal?      @db.Decimal(10, 2)
  heading   Decimal?      @db.Decimal(6, 2)
  recordedAt DateTime     @default(now())

  @@index([driverId, recordedAt])
  @@index([bookingId, recordedAt])
  @@index([recordedAt])
}

model DriverMessage {
  id         String   @id @default(cuid())
  bookingId  String
  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  senderId   String
  sender     User     @relation(fields: [senderId], references: [id])
  reason     String
  message    String
  sentAt     DateTime @default(now())
  readAt     DateTime?
}

model PricingRule {
  id          String   @id @default(cuid())
  name        String
  direction   TripDirection?
  tripType    TripType?
  amountCents Int
  currency    String   @default("USD")
  active      Boolean  @default(true)
  effectiveAt DateTime @default(now())
  policy      Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Payment {
  id          String        @id @default(cuid())
  bookingId   String
  booking     Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  provider    String
  providerRef String?
  checkoutUrl String?
  amountCents Int
  currency    String        @default("USD")
  status      PaymentStatus @default(PENDING)
  collectionMethod CollectionMethod?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  confirmedAt DateTime?

  @@index([providerRef])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
}

model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model BlogPost {
  id          String   @id @default(cuid())
  title       String
  excerpt     String
  content     String
  language    String   @default("fr")
  published   Boolean  @default(false)
  featured    Boolean  @default(false)
  publishedAt DateTime?
  bookingId   String?
  booking     Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  photos      BlogPhoto[]
  layout      BlogLayout @default(STACKED)
  coverPhotoId String?
  coverPhoto  BlogPhoto? @relation("BlogCover", fields: [coverPhotoId], references: [id], onDelete: SetNull)

  @@index([published, featured, publishedAt])
}

enum BlogLayout {
  STACKED
  GRID
  ALTERNATING
}

model BlogPhoto {
  id        String   @id @default(cuid())
  postId    String
  post      BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  caption   String
  mimeType  String
  data      Bytes
  sizeBytes Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sortOrder Int      @default(0)
  coverFor  BlogPost[] @relation("BlogCover")

  @@index([postId, createdAt])
}