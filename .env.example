# Copy to .env.local and replace placeholders privately; never commit real secrets.
DATABASE_URL="postgresql://username:password@localhost:5432/saiway_dev?schema=public"
# Optional pooled connection to the same database. Leave empty to use DATABASE_URL.
PRISMA_DATABASE_URL=""
AUTH_SECRET="replace-with-a-long-random-secret"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

NEXT_PUBLIC_MAP_TILE_URL="https://tile.openstreetmap.org/{z}/{x}/{y}.png"
NEXT_PUBLIC_MAP_TILE_ATTRIBUTION='&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap contributors</a>'
NEXT_PUBLIC_ROUTING_URL="https://router.project-osrm.org"
NEXT_PUBLIC_GEOCODING_URL="https://photon.komoot.io/api/"
NEXT_PUBLIC_REVERSE_GEOCODING_URL=""

# Same private value in the server and free external scheduler Authorization header.
CRON_SECRET="replace-with-a-different-long-random-secret"
# Generate stable keys once with scripts/setup-push.mjs; do not rotate on deployment.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="https://example.com"

# Optional ABA PayWay sandbox configuration.
PAYWAY_ENVIRONMENT="sandbox"
PAYWAY_MERCHANT_ID=""
PAYWAY_API_KEY=""
PAYWAY_PUBLIC_URL=""

# Optional integration-test server. Always override BOTH database URLs for tests.
VALIDATION_URL="http://localhost:3000"
